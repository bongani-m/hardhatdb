<% content_for :title, "Accounts" %>

<h1>Accounts</h1>
<p><%= link_to "New account", new_account_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Status</th>
      <th>Tags</th>
      <th>Notes</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @accounts.each do |account| %>
      <tr>
        <td><%= link_to account.name, account %></td>
        <td><%= account.email %></td>
        <td><%= account.status %></td>
        <td><%= account.tags_text %></td>
        <td><%= account.notes.map(&:body).join("; ") %></td>
        <td><%= link_to "Edit", edit_account_path(account) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
