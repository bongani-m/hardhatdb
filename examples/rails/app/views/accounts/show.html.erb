<% content_for :title, @account.name %>

<h1><%= @account.name %></h1>
<dl>
  <dt>Email</dt>
  <dd><%= @account.email %></dd>
  <dt>Status</dt>
  <dd><%= @account.status %></dd>
  <dt>Tags</dt>
  <dd><%= @account.tags_text.presence || "None" %></dd>
  <dt>Created</dt>
  <dd><%= @account.created_at %></dd>
</dl>

<h2>Notes</h2>
<ul>
  <% @account.notes.order(:id).each do |note| %>
    <li><%= note.body %></li>
  <% end %>
</ul>

<p>
  <%= link_to "Edit", edit_account_path(@account) %>
  <%= button_to "Delete", @account, method: :delete, form: { onsubmit: "return confirm('Delete this account?')" } %>
</p>
