<% content_for :title, "People" %>

<h1>People</h1>
<p><%= link_to "New person", new_person_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Phones</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @people.each do |person| %>
      <tr>
        <td><%= link_to person.name, person %></td>
        <td><%= person.email %></td>
        <td><%= person.phone_numbers_text %></td>
        <td><%= link_to "Edit", edit_person_path(person) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
